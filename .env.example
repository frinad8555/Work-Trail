# ====================================================================
# CareerGraph Environment Configuration
# ====================================================================

# 1. Neon PostgreSQL Connection String (include ?sslmode=require)
# Example: postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 2. Upstash Redis Connection
# Example: rediss://default:password@xyz.upstash.io:6379
REDIS_URL=

# 3. Embedding & LLM Settings
# Model for local open-source embeddings (Runs 100% free locally in Python)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM API Key (OpenAI or Gemini or Groq) for LangGraph Agent
# E.g. OPENAI_API_KEY=sk-... or GROQ_API_KEY=gsk_...
OPENAI_API_KEY=

# 4. Service Ports
PORT=5000
AI_SERVICE_PORT=8000
